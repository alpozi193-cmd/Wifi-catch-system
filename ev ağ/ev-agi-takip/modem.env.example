# Bu dosyayı kopyalayıp modem.env yapın veya PowerShell'de $env: ile verin.
# Modem arayüzü şifresi = genelde kutunun arkasındaki admin şifresi (Wi-Fi şifresi değil).

EV_AGI_MODEM_ENABLED=1
EV_AGI_MODEM_URL=http://192.168.1.1
EV_AGI_MODEM_USER=admin
EV_AGI_MODEM_PASS=buraya-modem-sifresi
# Turk Telekom / Superonline HGW (.hgw.local) icin: hgw veya zte
EV_AGI_MODEM_TYPE=hgw
EV_AGI_MODEM_INTERVAL=120

# Tip bulunamazsa sırayla deneyin: zte | huawei | tplink | openwrt | generic
